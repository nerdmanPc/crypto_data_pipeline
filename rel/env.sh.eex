#!/bin/sh

# Set the distribution type to long names
export RELEASE_DISTRIBUTION="name"

# Explicitly bind the node name to localhost inside the container
export RELEASE_NODE="$app@127.0.0.1"

# Force the BEAM to use port 9001 for cluster communication instead of a random port
export ELIXIR_ERL_OPTIONS="-kernel inet_dist_listen_min 9001 inet_dist_listen_max 9001"
